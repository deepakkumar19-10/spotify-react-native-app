an",coverUrl:"https://images.unsplash.com/photo-1518709268805-4e9042af9f23?w=400&h=400&fit=crop",year:2024,trackIds:["t31","t32","t33"],dominantColor:"#0284c7",type:"album"},{id:"al9",title:"Brown Munde Chronicles",artistId:"ar6",artistName:"AP Dhillon",coverUrl:"https://images.unsplash.com/photo-1492562080023-ab3db95bfbce?w=400&h=400&fit=crop",year:2023,trackIds:["t34","t35"],dominantColor:"#4338ca",type:"album"},{id:"al10",title:"Making Memories & Winning Speech",artistId:"ar10",artistName:"Karan Aujla",coverUrl:"https://images.unsplash.com/photo-1519085360753-af0119f7cbe7?w=400&h=400&fit=crop",year:2024,trackIds:["t36"],dominantColor:"#7c3aed",type:"single"}]},599);
