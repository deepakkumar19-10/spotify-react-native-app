__d(function(t,a,e,i,o,r,l){o.exports=[{id:"t1",title:"Kesariya (Bhairava Mix)",artist:"Arijit Singh & Pritam",artistId:"ar1",album:"Brahm\u0101stra & Romantic Hits",albumId:"al1",duration:268,audioUrl:"https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3",coverUrl:"https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=400&h=400&fit=crop",dominantColor:"#b45309",explicit:!1,lyrics:[{time:0,text:"\u0915\u0947\u0938\u0930\u093f\u092f\u093e \u0924\u0947\u0930\u093e \u0907\u0936\u094d\u0915\u093c \u0939\u0948 \u092a\u093f\u092f\u093e"},{time:14,text:"\u0930\u0902\u0917 \u091c\u093e\u090a\u0902 \u091c\u094b \u092e\u0948\u0902 \u0939\u093e\u0925 \u0932\u0917\u093e\u090a\u0902"},{time:28,text:"\u0926\u093f\u0928 \u092c\u0940\u0924\u0947 \u0938\u093e\u0930\u093e \u0924\u0947\u0930\u0940 \u092b\u093c\u093f\u0915\u094d\u0930 \u092e\u0947\u0902"},{time:42,text:"\u0930\u0948\u0928 \u0938\u093e\u0930\u0940 \u0924\u0947\u0930\u0940 \u0916\u0948\u0930 \u092e\u0928\u093e\u090a\u0902"},{time:60,text:"\u092a\u0924\u091d\u0921\u093c \u0915\u0947 \u092e\u094c\u0938\u092e \u092e\u0947\u0902 \u092d\u0940 \u0930\u0902\u0917 \u0916\u093f\u0932\u0947"},{time:82,text:"\u091c\u092c \u0938\u0947 \u0924\u0942 \u092e\u0947\u0930\u0947 \u0939\u092e\u0938\u092b\u093c\u0930 \u092e\u093f\u0932\u0947"},{time:104,text:"\u0915\u0947\u0938\u0930\u093f\u092f\u093e \u0924\u0947\u0930\u093e \u0907\u0936\u094d\u0915\u093c \u0939\u0948 \u092a\u093f\u092f\u093e..."}]},{id:"t2",title:"Tum Hi Ho (Soul Acoustic)",artist:"Arijit Singh",artistId:"ar1",album:"Brahm\u0101stra & Romantic Hits",albumId:"al1",duration:262,audioUrl:"https://www.soundhelix.com/examples/mp3/SoundHelix-Song-2.mp3",coverUrl:"https://images.unsplash.com/photo-1518709268805-4e9042af9f23?w=400&h=400&fit=crop",dominantColor:"#9a3412",explicit:!1,lyrics:[{time:0,text:"\u0939\u092e \u0924\u0947\u0930\u0947 \u092c\u093f\u0928 \u0905\u092c \u0930\u0939 \u0928\u0939\u0940\u0902 \u0938\u0915\u0924\u0947"},{time:15,text:"\u0924\u0947\u0930\u0947 \u092c\u093f\u0928\u093e \u0915\u094d\u092f\u093e \u0935\u091c\u0942\u0926 \u092e\u0947\u0930\u093e"},{time:32,text:"\u0924\u0941\u091d\u0938\u0947 \u091c\u0941\u0926\u093e \u0917\u0930 \u0939\u094b \u091c\u093e\u090f\u0902\u0917\u0947"},{time:48,text:"\u0924\u094b \u0916\u0941\u0926 \u0938\u0947 \u0939\u0940 \u0939\u094b \u091c\u093e\u090f\u0902\u0917\u0947 \u091c\u0941\u0926\u093e"},{time:66,text:"\u0915\u094d\u092f\u094b\u0902\u0915\u093f \u0924\u0941\u092e \u0939\u0940 \u0939\u094b, \u0905\u092c \u0924\u0941\u092e \u0939\u0940 \u0939\u094b"},{time:85,text:"\u091c\u093c\u093f\u0928\u094d\u0926\u0917\u0940 \u0905\u092c \u0924\u0941\u092e \u0939\u0940 \u0939\u094b"}]},{id:"t3",title:"Apna Bana Le",artist:"Arijit Singh & Sachin-Jigar",artistId:"ar1",album:"Brahm\u0101stra & Romantic Hits",albumId:"al1",duration:258,audioUrl:"https://www.soundhelix.com/examples/mp3/SoundHelix-Song-3.mp3",coverUrl:"https://images.unsplash.com/photo-1516450360452-9312f5e86fc7?w=400&h=400&fit=crop",dominantColor:"#be185d",explicit:!1,lyrics:[{time:0,text:"\u0924\u0942 \u092e\u0947\u0930\u093e \u0915\u094b\u0908 \u0928\u093e \u0939\u094b\u0915\u0947 \u092d\u0940 \u0915\u0941\u091b \u0932\u093e\u0917\u0947"},{time:16,text:"\u0915\u093f\u092f\u093e \u0930\u0947 \u091c\u094b \u092d\u0940 \u0924\u0942\u0928\u0947 \u0926\u093f\u0932 \u0915\u0947 \u0906\u0917\u0947"},{time:35,text:"\u0905\u092a\u0928\u093e \u092c\u0928\u093e \u0932\u0947 \u092a\u093f\u092f\u093e, \u0905\u092a\u0928\u093e \u092c\u0928\u093e \u0932\u0947 \u092a\u093f\u092f\u093e"},{time:55,text:"\u0926\u093f\u0932 \u0915\u0947 \u0928\u0917\u0930 \u092e\u0947\u0902 \u0918\u0930 \u092c\u0938\u093e \u0932\u0947 \u092a\u093f\u092f\u093e"}]},{id:"t4",title:"Channa Mereya (Acoustic Unplugged)",artist:"Arijit Singh",artistId:"ar1",album:"Brahm\u0101stra & Romantic Hits",albumId:"al1",duration:289,audioUrl:"https://www.soundhelix.com/examples/mp3/SoundHelix-Song-4.mp3",coverUrl:"https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?w=400&h=400&fit=crop",dominantColor:"#4338ca",explicit:!1,lyrics:[{time:0,text:"\u0905\u091a\u094d\u091b\u093e \u091a\u0932\u0924\u093e \u0939\u0942\u0901, \u0926\u0941\u0906\u0913\u0902 \u092e\u0947\u0902 \u092f\u093e\u0926 \u0930\u0916\u0928\u093e"},{time:18,text:"\u092e\u0947\u0930\u0947 \u091c\u093c\u093f\u0915\u094d\u0930 \u0915\u093e \u091c\u093c\u0941\u092c\u093e\u0902 \u092a\u0947 \u0938\u094d\u0935\u093e\u0926 \u0930\u0916\u0928\u093e"},{time:36,text:"\u0905\u0902\u0927\u0947\u0930\u093e \u0924\u0947\u0930\u093e \u092e\u0948\u0902\u0928\u0947 \u0932\u0947 \u0932\u093f\u092f\u093e"},{time:54,text:"\u092e\u0947\u0930\u093e \u0909\u091c\u0932\u093e \u0938\u093f\u0924\u093e\u0930\u093e \u0924\u0947\u0930\u0947 \u0928\u093e\u092e \u0915\u093f\u092f\u093e"},{time:75,text:"\u0913 \u091a\u0928\u094d\u0928\u093e \u092e\u0947\u0930\u0947\u092f\u093e \u092e\u0947\u0930\u0947\u092f\u093e, \u091a\u0928\u094d\u0928\u093e \u092e\u0947\u0930\u0947\u092f\u093e!"}]},{id:"t5",title:"Raataan Lambiyan",artist:"Jubin Nautiyal & Asees Kaur",artistId:"ar1",album:"Brahm\u0101stra & Romantic Hits",albumId:"al1",duration:230,audioUrl:"https://www.soundhelix.com/examples/mp3/SoundHelix-Song-5.mp3",coverUrl:"https://images.unsplash.com/photo-1508700115892-45ecd05ae2ad?w=400&h=400&fit=crop",dominantColor:"#047857",explicit:!1,lyrics:[{time:0,text:"\u0924\u0947\u0930\u0940 \u092e\u0947\u0930\u0940 \u0917\u0932\u094d\u0932\u093e\u0902 \u0939\u094b\u0917\u0940 \u092e\u0936\u0939\u0942\u0930"},{time:14,text:"\u0915\u0930 \u0928\u093e \u0915\u092d\u0940 \u0924\u0942 \u092e\u0941\u091d\u0947 \u0928\u091c\u093c\u0930\u094b\u0902 \u0938\u0947 \u0926\u0942\u0930"},{time:30,text:"\u0915\u093e\u091f\u0942\u0901 \u0915\u0948\u0938\u0947 \u0930\u093e\u0924\u093e\u0902 \u0913 \u0938\u093e\u0902\u0935\u0930\u0947?"},{time:48,text:"\u0930\u093e\u0924\u093e\u0902 \u0932\u092e\u094d\u092c\u093f\u092f\u093e\u0902 \u0932\u092e\u094d\u092c\u093f\u092f\u093e\u0902 \u0930\u0947, \u0915\u091f\u0947 \u0924\u0947\u0930\u0947 \u0938\u0902\u0917\u093f\u092f\u093e\u0902 \u0938\u0902\u0917\u093f\u092f\u093e\u0902 \u0930\u0947"}]},{id:"t6",title:"Shayad (Soulful Reprise)",artist:"Arijit Singh & Pritam",artistId:"ar1",album:"Brahm\u0101stra & Romantic Hits",albumId:"al1",duration:247,audioUrl:"https://www.soundhelix.com/examples/mp3/SoundHelix-Song-6.mp3",coverUrl:"https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=400&h=400&fit=crop",dominantColor:"#0284c7",explicit:!1,lyrics:[{time:0,text:"\u0936\u093e\u092f\u0926 \u0915\u092d\u0940 \u0928\u093e \u0915\u0939 \u0938\u0915\u0942\u0901 \u092e\u0948\u0902 \u0924\u0941\u092e\u0915\u094b"},{time:15,text:"\u0915\u0939\u0947 \u092c\u093f\u0928\u093e \u0938\u092e\u091d \u0932\u094b \u0924\u0941\u092e \u0936\u093e\u092f\u0926"},{time:32,text:"\u0936\u093e\u092f\u0926 \u092e\u0947\u0930\u0947 \u0916\u094d\u092f\u093e\u0932 \u092e\u0947\u0902 \u0924\u0941\u092e \u090f\u0915 \u0926\u093f\u0928"},{time:50,text:"\u092e\u093f\u0932\u094b \u092e\u0941\u091d\u0947 \u0915\u0939\u0940\u0902 \u092a\u0947 \u0917\u0941\u092e \u0936\u093e\u092f\u0926"}]},{id:"t7",title:"295 (Immortal Anthem)",artist:"Sidhu Moosewala",artistId:"ar2",album:"Moosetape Forever",albumId:"al2",duration:270,audioUrl:"https://www.soundhelix.com/examples/mp3/SoundHelix-Song-7.mp3",coverUrl:"https://images.unsplash.com/photo-1509198397868-475647b2a1e5?w=400&h=400&fit=crop",dominantColor:"#1e3a8a",explicit:!0,lyrics:[{time:0,text:"Dass kithe karaan claim yaaran"},{time:16,text:"Kithon labban shanti da samaan yaaran"},{time:35,text:"Roz sunan nu mildi ik nayi virodhi dhara"},{time:54,text:"Nitt controversy create kiti jandi ae"},{time:76,text:"Dharman de na te kade jaatan de na te"}]},{id:"t8",title:"Chorni (Club Bang)",artist:"Sidhu Moosewala & DIVINE",artistId:"ar2",album:"Moosetape Forever",albumId:"al2",duration:215,audioUrl:"https://www.soundhelix.com/examples/mp3/SoundHelix-Song-8.mp3",coverUrl:"https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=400&h=400&fit=crop",dominantColor:"#b91c1c",explicit:!0,lyrics:[{time:0,text:"Aukaat vich rehne aan, par bolde na ghat"},{time:15,text:"Gaddi kaali sheeshe kaale, sir utte hath"},{time:34,text:"Bombay to Punjab, sidha connection"},{time:52,text:"Chorni, tere piche saara shehar badnaam!"}]},{id:"t9",title:"The Last Ride",artist:"Sidhu Moosewala",artistId:"ar2",album:"Moosetape Forever",albumId:"al2",duration:260,audioUrl:"https://www.soundhelix.com/examples/mp3/SoundHelix-Song-9.mp3",coverUrl:"https://images.unsplash.com/photo-1509198397868-475647b2a1e5?w=400&h=400&fit=crop",dominantColor:"#18181b",explicit:!0,lyrics:[{time:0,text:"Ho chobbar de chehre utte noor dasda"},{time:18,text:"Ni ehda uthuga jawani ch janaaza mithhiye"},{time:38,text:"Lokan diyan akhan ch rhadakda gabru"},{time:58,text:"Wazir wangu jatt da swag wakhra!"}]},{id:"t10",title:"Levels (High Energy)",artist:"Sidhu Moosewala & Sunny Malton",artistId:"ar2",album:"Moosetape Forever",albumId:"al2",duration:232,audioUrl:"https://www.soundhelix.com/examples/mp3/SoundHelix-Song-10.mp3",coverUrl:"https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=400&h=400&fit=crop",dominantColor:"#0284c7",explicit:!0,lyrics:[{time:0,text:"Ho khadku group da swag soniye"},{time:16,text:"Tu match kar sakan na sadde levels nu!"},{time:35,text:"Worldwide tour te sold out shows"},{time:55,text:"Sidhu Moosewala name speaks for itself!"}]},{id:"t11",title:"Lover (Coachella Vibes)",artist:"Diljit Dosanjh",artistId:"ar3",album:"MoonChild & G.O.A.T.",albumId:"al3",duration:204,audioUrl:"https://www.soundhelix.com/examples/mp3/SoundHelix-Song-11.mp3",coverUrl:"https://images.unsplash.com/photo-1470225620780-dba8ba36b745?w=400&h=400&fit=crop",dominantColor:"#c2410c",explicit:!1,lyrics:[{time:0,text:"Tera ni main lover, koi hor labh le"},{time:14,text:"Akhan vich akhan paa ke dil mang le"},{time:30,text:"Mainu lagda tu rab di banayi moorat"},{time:48,text:"Diljit Dosanjh on the beat!"}]},{id:"t12",title:"G.O.A.T. (Stadium Anthem)",artist:"Diljit Dosanjh",artistId:"ar3",album:"MoonChild & G.O.A.T.",albumId:"al3",duration:226,audioUrl:"https://www.soundhelix.com/examples/mp3/SoundHelix-Song-12.mp3",coverUrl:"https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=400&h=400&fit=crop",dominantColor:"#b45309",explicit:!1,lyrics:[{time:0,text:"Diamonds on my wrist, pagg matching te tie"},{time:16,text:"Lokan nu lagda gaddi slow chali par speed high"},{time:35,text:"G.O.A.T. jatt kade jhukda ni kisse moore!"}]},{id:"t13",title:"Born To Shine",artist:"Diljit Dosanjh",artistId:"ar3",album:"MoonChild & G.O.A.T.",albumId:"al3",duration:212,audioUrl:"https://www.soundhelix.com/examples/mp3/SoundHelix-Song-13.mp3",coverUrl:"https://images.unsplash.com/photo-1470225620780-dba8ba36b745?w=400&h=400&fit=crop",dominantColor:"#059669",explicit:!1,lyrics:[{time:0,text:"Kade rukke na haunsle, kade chhadde na jazbe"},{time:15,text:"Jihna ne kiti mehnat, ohi kende rab di mehar te"},{time:32,text:"We were born to shine!"}]},{id:"t14",title:"52 Gaj Ka Daman (Desi Folk)",artist:"Renuka Panwar",artistId:"ar4",album:"Haryanvi Dholak & Swag",albumId:"al4",duration:200,audioUrl:"https://www.soundhelix.com/examples/mp3/SoundHelix-Song-14.mp3",coverUrl:"https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?w=400&h=400&fit=crop",dominantColor:"#be185d",explicit:!1,lyrics:[{time:0,text:"\u0918\u0942\u0901\u0918\u091f \u0915\u0940 \u0913\u091f \u092e\u0947\u0902 \u091a\u092e\u0915\u0947 \u0930\u0942\u092a \u0928\u093f\u0930\u093e\u0932\u093e"},{time:16,text:"\u092c\u093e\u0935\u0928 \u0917\u091c \u0915\u093e \u0926\u093e\u092e\u0928 \u092a\u0939\u0930 \u092e\u091f\u0915 \u0915\u0947 \u091a\u093e\u0932\u0942\u0901\u0917\u0940"},{time:35,text:"\u0917\u093e\u0901\u0935 \u0917\u0932\u0940 \u0915\u0947 \u0932\u094b\u0917 \u0932\u0916\u093e\u0935\u0947\u0902"},{time:54,text:"\u0930\u0947\u0923\u0941\u0915\u093e \u092a\u0902\u0935\u093e\u0930 \u0915\u093e \u0939\u0930\u093f\u092f\u093e\u0923\u0935\u0940 \u0927\u092e\u093e\u0915\u093e!"}]},{id:"t15",title:"Kothe Chad Lalkaru",artist:"Masoom Sharma",artistId:"ar5",album:"Haryanvi Dholak & Swag",albumId:"al4",duration:224,audioUrl:"https://www.soundhelix.com/examples/mp3/SoundHelix-Song-15.mp3",coverUrl:"https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?w=400&h=400&fit=crop",dominantColor:"#047857",explicit:!1,lyrics:[{time:0,text:"\u0915\u094b\u0920\u0947 \u091a\u0922\u093c \u0932\u0932\u0915\u093e\u0930\u0942\u0902 \u092e\u0948\u0902 \u0924\u094b \u092a\u0942\u0930\u093e \u091c\u093c\u093f\u0932\u093e \u0939\u093f\u0932\u093e \u0926\u0942\u0901"},{time:18,text:"\u092e\u093e\u0938\u0942\u092e \u0936\u0930\u094d\u092e\u093e \u0915\u093e \u0926\u0947\u0938\u0940 \u0905\u0902\u0926\u093e\u091c"},{time:38,text:"\u0939\u0930\u093f\u092f\u093e\u0923\u093e \u092e\u0947\u0902 \u0917\u0942\u0902\u091c\u0947 \u0905\u092a\u0928\u0947 \u092c\u094b\u0932!"}]},{id:"t16",title:"Chatak Matak",artist:"Renuka Panwar",artistId:"ar4",album:"Haryanvi Dholak & Swag",albumId:"al4",duration:198,audioUrl:"https://www.soundhelix.com/examples/mp3/SoundHelix-Song-16.mp3",coverUrl:"https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=400&h=400&fit=crop",dominantColor:"#e11d48",explicit:!1,lyrics:[{time:0,text:"\u091a\u091f\u0915 \u092e\u091f\u0915 \u0915\u0947 \u091a\u093e\u0932\u0928 \u0932\u093e\u0917\u0947"},{time:15,text:"\u091d\u0942\u092e\u0930 \u091d\u092e\u0915\u0947 \u092a\u093e\u092f\u0932 \u092c\u093e\u091c\u0947"},{time:32,text:"\u0926\u0947\u0938\u0940 \u0922\u094b\u0932\u0915 \u0915\u0940 \u0925\u093e\u092a \u092a\u0947 \u0928\u093e\u091a\u0947 \u0939\u0930\u093f\u092f\u093e\u0923\u093e \u0938\u093e\u0930\u093e!"}]},{id:"t17",title:"Goli Chal Javegi",artist:"Masoom Sharma",artistId:"ar5",album:"Haryanvi Dholak & Swag",albumId:"al4",duration:218,audioUrl:"https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3",coverUrl:"https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?w=400&h=400&fit=crop",dominantColor:"#4338ca",explicit:!1,lyrics:[{time:0,text:"\u0905\u0930\u0947 \u092c\u0926\u092e\u093e\u0936\u0940 \u0915\u0940 \u092c\u093e\u0924 \u0928\u093e \u0915\u0930 \u092f\u093e\u0930"},{time:17,text:"\u0917\u094b\u0932\u0940 \u091a\u093e\u0932 \u091c\u093e\u0935\u0947\u0917\u0940 \u091c\u092c \u0930\u094b\u092c \u0926\u093f\u0916\u0947\u0917\u093e"},{time:36,text:"\u092f\u093e\u0930\u0940 \u0905\u092a\u0928\u0940 \u091c\u093e\u0928 \u0938\u0947 \u092a\u094d\u092f\u093e\u0930\u0940!"}]},{id:"t18",title:"Moto (Haryanvi Hit)",artist:"Diler Kharkiya & Renuka Panwar",artistId:"ar4",album:"Haryanvi Dholak & Swag",albumId:"al4",duration:210,audioUrl:"https://www.soundhelix.com/examples/mp3/SoundHelix-Song-2.mp3",coverUrl:"https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?w=400&h=400&fit=crop",dominantColor:"#d97706",explicit:!1,lyrics:[{time:0,text:"\u092e\u0947\u0930\u0940 \u092e\u094b\u091f\u094b \u0918\u0923\u0940 \u0928\u0916\u0930\u0940\u0932\u0940"},{time:15,text:"\u091a\u093e\u0932 \u0926\u093f\u0916\u093e\u0935\u0947 \u091a\u093e\u0932 \u0936\u0930\u094d\u092e\u0940\u0932\u0940"},{time:34,text:"\u0938\u0942\u091f \u0917\u0941\u0932\u093e\u092c\u0940 \u091c\u091a\u0924\u093e \u0909\u0938\u092a\u0947 \u092a\u0942\u0930\u093e!"}]},{id:"t19",title:"Sprint Beast (165 BPM High Cadence)",artist:"Titan Beast Fuel",artistId:"ar8",album:"Beast Mode Cardio 160 BPM",albumId:"al5",duration:245,audioUrl:"https://www.soundhelix.com/examples/mp3/SoundHelix-Song-3.mp3",coverUrl:"https://images.unsplash.com/photo-1483721310020-03333e577078?w=400&h=400&fit=crop",dominantColor:"#e11d48",explicit:!1,lyrics:[{time:0,text:"[Running Cadence: 165 BPM Active]"},{time:15,text:"Lock your breath, match the stride"},{time:30,text:"No fatigue can stop your drive"},{time:50,text:"Push through the burn, break through the wall!"},{time:75,text:"Finish line in sight, sprint now!"}]},{id:"t20",title:"Cardio Accelerator (160 BPM Continuous)",artist:"Titan Beast Fuel",artistId:"ar8",album:"Beast Mode Cardio 160 BPM",albumId:"al5",duration:255,audioUrl:"https://www.soundhelix.com/examples/mp3/SoundHelix-Song-4.mp3",coverUrl:"https://images.unsplash.com/photo-1517838277536-f5f99be501cd?w=400&h=400&fit=crop",dominantColor:"#f97316",explicit:!1,lyrics:[{time:0,text:"[Treadmill Interval: 160 BPM]"},{time:20,text:"Feel the pulse inside your chest"},{time:45,text:"Better than yesterday, leave the rest"},{time:70,text:"Every kilometer counts, keep moving!"}]},{id:"t21",title:"Marathon Rhythm (158 BPM Steady Pace)",artist:"Titan Beast Fuel",artistId:"ar8",album:"Beast Mode Cardio 160 BPM",albumId:"al5",duration:275,audioUrl:"https://www.soundhelix.com/examples/mp3/SoundHelix-Song-5.mp3",coverUrl:"https://images.unsplash.com/photo-1483721310020-03333e577078?w=400&h=400&fit=crop",dominantColor:"#0284c7",explicit:!1,lyrics:[{time:0,text:"[Steady Marathon Pace]"},{time:25,text:"Breathe in deep, exhale power"},{time:55,text:"This is your golden training hour"},{time:90,text:"Mile after mile, relentless speed!"}]},{id:"t22",title:"HIIT Explosion (170 BPM Peak)",artist:"Titan Beast Fuel",artistId:"ar8",album:"Beast Mode Cardio 160 BPM",albumId:"al5",duration:230,audioUrl:"https://www.soundhelix.com/examples/mp3/SoundHelix-Song-6.mp3",coverUrl:"https://images.unsplash.com/photo-1517838277536-f5f99be501cd?w=400&h=400&fit=crop",dominantColor:"#9333ea",explicit:!1,lyrics:[{time:0,text:"[HIIT Max Effort Interval]"},{time:15,text:"3... 2... 1... MAXIMUM EFFORT!"},{time:35,text:"Full throttle sprint, heart rate peak!"},{time:60,text:"Recover for 10, then hit it again!"}]},{id:"t23",title:"Unstoppable Mindset (Warrior Speech)",artist:"Titan Beast Fuel",artistId:"ar8",album:"Unstoppable Motivation & Gym Drive",albumId:"al6",duration:260,audioUrl:"https://www.soundhelix.com/examples/mp3/SoundHelix-Song-7.mp3",coverUrl:"https://images.unsplash.com/photo-1517838277536-f5f99be501cd?w=400&h=400&fit=crop",dominantColor:"#f97316",explicit:!1,lyrics:[{time:0,text:"Nobody is going to hand you success."},{time:14,text:"You have to wake up hungry every single morning."},{time:32,text:"When you feel like quitting, remember why you started."},{time:54,text:"Pain is temporary. Pride lasts forever!"},{time:80,text:"LIFT IT! PUSH IT! OWN THE WEIGHT!"}]},{id:"t24",title:"Rise From The Ashes (Champion Drive)",artist:"Titan Beast Fuel",artistId:"ar8",album:"Unstoppable Motivation & Gym Drive",albumId:"al6",duration:245,audioUrl:"https://www.soundhelix.com/examples/mp3/SoundHelix-Song-8.mp3",coverUrl:"https://images.unsplash.com/photo-1509198397868-475647b2a1e5?w=400&h=400&fit=crop",dominantColor:"#e11d48",explicit:!1,lyrics:[{time:0,text:"They said you couldn't do it."},{time:18,text:"They doubted your discipline."},{time:40,text:"Now prove them wrong in silence."},{time:65,text:"Heavy iron, pure dedication!"}]},{id:"t25",title:"Discipline Over Motivation (Iron Focus)",artist:"Titan Beast Fuel",artistId:"ar8",album:"Unstoppable Motivation & Gym Drive",albumId:"al6",duration:250,audioUrl:"https://www.soundhelix.com/examples/mp3/SoundHelix-Song-9.mp3",coverUrl:"https://images.unsplash.com/photo-1517838277536-f5f99be501cd?w=400&h=400&fit=crop",dominantColor:"#15803d",explicit:!1,lyrics:[{time:0,text:"Motivation gets you started."},{time:16,text:"Discipline keeps you going when motivation fades."},{time:38,text:"One more rep! One more set!"},{time:62,text:"Greatness is built in the dark!"}]},{id:"t26",title:"The Legacy Anthem (Heavy Bass)",artist:"Titan Beast Fuel",artistId:"ar8",album:"Unstoppable Motivation & Gym Drive",albumId:"al6",duration:240,audioUrl:"https://www.soundhelix.com/examples/mp3/SoundHelix-Song-10.mp3",coverUrl:"https://images.unsplash.com/photo-1483721310020-03333e577078?w=400&h=400&fit=crop",dominantColor:"#4338ca",explicit:!1,lyrics:[{time:0,text:"Leave your mark on the world."},{time:20,text:"Built with sweat, grit, and sacrifice."},{time:48,text:"Unbreakable focus. Champion mindset!"}]},{id:"t27",title:"Shree Hanuman Chalisa (Divine Dhun)",artist:"Hariharan & Gulshan Kumar",artistId:"ar7",album:"Shree Hanuman & Krishna Bhakti",albumId:"al7",duration:380,audioUrl:"https://www.soundhelix.com/examples/mp3/SoundHelix-Song-11.mp3",coverUrl:"https://images.unsplash.com/photo-1609619385002-f40f1df9b7eb?w=400&h=400&fit=crop",dominantColor:"#d97706",explicit:!1,lyrics:[{time:0,text:"\u0936\u094d\u0930\u0940\u0917\u0941\u0930\u0941 \u091a\u0930\u0928 \u0938\u0930\u094b\u091c \u0930\u091c, \u0928\u093f\u091c \u092e\u0928\u0941 \u092e\u0941\u0915\u0941\u0930\u0941 \u0938\u0941\u0927\u093e\u0930\u093f"},{time:18,text:"\u092c\u0930\u0928\u090a\u0902 \u0930\u0918\u0941\u092c\u0930 \u092c\u093f\u092e\u0932 \u091c\u0938\u0941, \u091c\u094b \u0926\u093e\u092f\u0915\u0941 \u092b\u0932 \u091a\u093e\u0930\u093f"},{time:38,text:"\u092c\u0941\u0926\u094d\u0927\u093f\u0939\u0940\u0928 \u0924\u0928\u0941 \u091c\u093e\u0928\u093f\u0915\u0947, \u0938\u0941\u092e\u093f\u0930\u094c\u0902 \u092a\u0935\u0928-\u0915\u0941\u092e\u093e\u0930"},{time:58,text:"\u092c\u0932 \u092c\u0941\u0926\u094d\u0927\u093f \u092c\u093f\u0926\u094d\u092f\u093e \u0926\u0947\u0939\u0941 \u092e\u094b\u0939\u093f\u0902, \u0939\u0930\u0939\u0941 \u0915\u0932\u0947\u0938 \u092c\u093f\u0915\u093e\u0930"},{time:82,text:"\u091c\u092f \u0939\u0928\u0941\u092e\u093e\u0928 \u091c\u094d\u091e\u093e\u0928 \u0917\u0941\u0928 \u0938\u093e\u0917\u0930, \u091c\u092f \u0915\u092a\u0940\u0938 \u0924\u093f\u0939\u0941\u0902 \u0932\u094b\u0915 \u0909\u091c\u093e\u0917\u0930"},{time:110,text:"\u0930\u093e\u092e\u0926\u0942\u0924 \u0905\u0924\u0941\u0932\u093f\u0924 \u092c\u0932 \u0927\u093e\u092e\u093e, \u0905\u0902\u091c\u0928\u093f-\u092a\u0941\u0924\u094d\u0930 \u092a\u0935\u0928\u0938\u0941\u0924 \u0928\u093e\u092e\u093e"},{time:140,text:"\u092e\u0939\u093e\u092c\u0940\u0930 \u092c\u093f\u0915\u094d\u0930\u092e \u092c\u091c\u0930\u0902\u0917\u0940, \u0915\u0941\u092e\u0924\u093f \u0928\u093f\u0935\u093e\u0930 \u0938\u0941\u092e\u0924\u093f \u0915\u0947 \u0938\u0902\u0917\u0940"}]},{id:"t28",title:"Shiv Tandav Stotram (Fierce Chants)",artist:"Shankar Mahadevan",artistId:"ar9",album:"Shiv Shakti Chants & Stotram",albumId:"al8",duration:320,audioUrl:"https://www.soundhelix.com/examples/mp3/SoundHelix-Song-12.mp3",coverUrl:"https://images.unsplash.com/photo-1518709268805-4e9042af9f23?w=400&h=400&fit=crop",dominantColor:"#0284c7",explicit:!1,lyrics:[{time:0,text:"\u091c\u091f\u093e\u091f\u0935\u0940\u0917\u0932\u091c\u094d\u091c\u0932\u092a\u094d\u0930\u0935\u093e\u0939\u092a\u093e\u0935\u093f\u0924\u0938\u094d\u0925\u0932\u0947"},{time:16,text:"\u0917\u0932\u0947\u093d\u0935\u0932\u092e\u094d\u092c\u094d\u092f \u0932\u092e\u094d\u092c\u093f\u0924\u093e\u0902 \u092d\u0941\u091c\u0919\u094d\u0917\u0924\u0941\u0919\u094d\u0917\u092e\u093e\u0932\u093f\u0915\u093e\u092e\u094d"},{time:36,text:"\u0921\u092e\u0921\u094d\u0921\u092e\u0921\u094d\u0921\u092e\u0921\u094d\u0921\u092e\u0928\u094d\u0928\u093f\u0928\u093e\u0926\u0935\u0921\u094d\u0921\u092e\u0930\u094d\u0935\u092f\u0902"},{time:56,text:"\u091a\u0915\u093e\u0930 \u091a\u0923\u094d\u0921\u0924\u093e\u0923\u094d\u0921\u0935\u0902 \u0924\u0928\u094b\u0924\u0941 \u0928\u0903 \u0936\u093f\u0935\u0903 \u0936\u093f\u0935\u092e\u094d"},{time:80,text:"\u0939\u0930 \u0939\u0930 \u092e\u0939\u093e\u0926\u0947\u0935! \u0950 \u0928\u092e\u0903 \u0936\u093f\u0935\u093e\u092f!"}]},{id:"t29",title:"Achyutam Keshavam (Peaceful Bhakti)",artist:"Hariharan & Anuradha",artistId:"ar7",album:"Shree Hanuman & Krishna Bhakti",albumId:"al7",duration:290,audioUrl:"https://www.soundhelix.com/examples/mp3/SoundHelix-Song-13.mp3",coverUrl:"https://images.unsplash.com/photo-1609619385002-f40f1df9b7eb?w=400&h=400&fit=crop",dominantColor:"#059669",explicit:!1,lyrics:[{time:0,text:"\u0905\u091a\u094d\u092f\u0941\u0924\u0902 \u0915\u0947\u0936\u0935\u0902 \u0915\u0943\u0937\u094d\u0923 \u0926\u093e\u092e\u094b\u0926\u0930\u0902"},{time:18,text:"\u0930\u093e\u092e \u0928\u093e\u0930\u093e\u092f\u0923\u0902 \u091c\u093e\u0928\u0915\u0940 \u0935\u0932\u094d\u0932\u092d\u092e\u094d"},{time:38,text:"\u0915\u094c\u0928 \u0915\u0939\u0924\u0947 \u0939\u0948\u0902 \u092d\u0917\u0935\u093e\u0928 \u0906\u0924\u0947 \u0928\u0939\u0940\u0902"},{time:58,text:"\u0924\u0941\u092e \u092e\u0940\u0930\u093e \u0915\u0947 \u091c\u0948\u0938\u0947 \u092c\u0941\u0932\u093e\u0924\u0947 \u0928\u0939\u0940\u0902"},{time:82,text:"\u0905\u091a\u094d\u092f\u0941\u0924\u0902 \u0915\u0947\u0936\u0935\u0902 \u0915\u0943\u0937\u094d\u0923 \u0926\u093e\u092e\u094b\u0926\u0930\u0902..."}]},{id:"t30",title:"Maha Mrityunjaya Mantra (108 Japa)",artist:"Hariharan & Anuradha",artistId:"ar7",album:"Shree Hanuman & Krishna Bhakti",albumId:"al7",duration:340,audioUrl:"https://www.soundhelix.com/examples/mp3/SoundHelix-Song-14.mp3",coverUrl:"https://images.unsplash.com/photo-1518709268805-4e9042af9f23?w=400&h=400&fit=crop",dominantColor:"#7c3aed",explicit:!1,lyrics:[{time:0,text:"\u0950 \u0924\u094d\u0930\u094d\u092f\u092e\u094d\u092c\u0915\u0902 \u092f\u091c\u093e\u092e\u0939\u0947 \u0938\u0941\u0917\u0928\u094d\u0927\u093f\u0902 \u092a\u0941\u0937\u094d\u091f\u093f\u0935\u0930\u094d\u0927\u0928\u092e\u094d"},{time:20,text:"\u0909\u0930\u094d\u0935\u093e\u0930\u0941\u0915\u092e\u093f\u0935 \u092c\u0928\u094d\u0927\u0928\u093e\u0928\u094d \u092e\u0943\u0924\u094d\u092f\u094b\u0930\u094d\u092e\u0941\u0915\u094d\u0937\u0940\u092f \u092e\u093e\u092e\u0943\u0924\u093e\u0924\u094d"},{time:45,text:"\u0950 \u0928\u092e\u0903 \u0936\u093f\u0935\u093e\u092f, \u0939\u0930 \u0939\u0930 \u0936\u092e\u094d\u092d\u0942!"}]},{id:"t31",title:"Om Jai Jagdish Hare (Sampurna Aarti)",artist:"Anuradha Paudwal",artistId:"ar7",album:"Shiv Shakti Chants & Stotram",albumId:"al8",duration:310,audioUrl:"https://www.soundhelix.com/examples/mp3/SoundHelix-Song-15.mp3",coverUrl:"https://images.unsplash.com/photo-1609619385002-f40f1df9b7eb?w=400&h=400&fit=crop",dominantColor:"#d97706",explicit:!1,lyrics:[{time:0,text:"\u0950 \u091c\u092f \u091c\u0917\u0926\u0940\u0936 \u0939\u0930\u0947, \u0938\u094d\u0935\u093e\u092e\u0940 \u091c\u092f \u091c\u0917\u0926\u0940\u0936 \u0939\u0930\u0947"},{time:18,text:"\u092d\u0915\u094d\u0924 \u091c\u0928\u094b\u0902 \u0915\u0947 \u0938\u0902\u0915\u091f \u0926\u093e\u0938 \u091c\u0928\u094b\u0902 \u0915\u0947 \u0938\u0902\u0915\u091f"},{time:38,text:"\u0915\u094d\u0937\u0923 \u092e\u0947\u0902 \u0926\u0942\u0930 \u0915\u0930\u0947, \u0950 \u091c\u092f \u091c\u0917\u0926\u0940\u0936 \u0939\u0930\u0947!"},{time:60,text:"\u091c\u094b \u0927\u094d\u092f\u093e\u0935\u0947 \u092b\u0932 \u092a\u093e\u0935\u0947, \u0926\u0941\u0903\u0916 \u092c\u093f\u0928\u0938\u0947 \u092e\u0928 \u0915\u093e"}]},{id:"t32",title:"Karpura Gauram Karunavataram",artist:"Shankar Mahadevan",artistId:"ar9",album:"Shiv Shakti Chants & Stotram",albumId:"al8",duration:260,audioUrl:"https://www.soundhelix.com/examples/mp3/SoundHelix-Song-16.mp3",coverUrl:"https://images.unsplash.com/photo-1518709268805-4e9042af9f23?w=400&h=400&fit=crop",dominantColor:"#0284c7",explicit:!1,lyrics:[{time:0,text:"\u0915\u0930\u094d\u092a\u0942\u0930\u0917\u094c\u0930\u0902 \u0915\u0930\u0941\u0923\u093e\u0935\u0924\u093e\u0930\u0902 \u0938\u0902\u0938\u093e\u0930\u0938\u093e\u0930\u092e\u094d"},{time:18,text:"\u092d\u0941\u091c\u0917\u0947\u0928\u094d\u0926\u094d\u0930\u0939\u093e\u0930\u092e\u094d \u0938\u0926\u093e\u0935\u0938\u0928\u094d\u0924\u0902 \u0939\u0943\u0926\u092f\u093e\u0930\u0935\u093f\u0928\u094d\u0926\u0947"},{time:38,text:"\u092d\u0935\u0902 \u092d\u0935\u093e\u0928\u0940\u0938\u0939\u093f\u0924\u0902 \u0928\u092e\u093e\u092e\u093f"}]},{id:"t33",title:"Radhe Radhe Govinda (Vrindavan Dhun)",artist:"Hariharan",artistId:"ar7",album:"Shiv Shakti Chants & Stotram",albumId:"al8",duration:285,audioUrl:"https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3",coverUrl:"https://images.unsplash.com/photo-1609619385002-f40f1df9b7eb?w=400&h=400&fit=crop",dominantColor:"#10b981",explicit:!1,lyrics:[{time:0,text:"\u0930\u093e\u0927\u0947 \u0930\u093e\u0927\u0947 \u0917\u094b\u0935\u093f\u0928\u094d\u0926 \u0917\u094b\u092a\u093e\u0932 \u0930\u093e\u0927\u0947"},{time:18,text:"\u0936\u094d\u0930\u0940 \u092c\u093e\u0902\u0915\u0947 \u092c\u093f\u0939\u093e\u0930\u0940 \u0928\u0928\u094d\u0926\u0932\u093e\u0932 \u0930\u093e\u0927\u0947"},{time:40,text:"\u0935\u0943\u0928\u094d\u0926\u093e\u0935\u0928 \u0915\u0947 \u0915\u0923-\u0915\u0923 \u092e\u0947\u0902 \u092c\u0938\u0947 \u0939\u0948\u0902 \u0915\u0928\u094d\u0939\u0948\u092f\u093e"}]},{id:"t34",title:"Brown Munde",artist:"AP Dhillon, Gurinder Gill, Shinda Kahlon",artistId:"ar6",album:"Brown Munde Chronicles",albumId:"al9",duration:265,audioUrl:"https://www.soundhelix.com/examples/mp3/SoundHelix-Song-2.mp3",coverUrl:"https://images.unsplash.com/photo-1492562080023-ab3db95bfbce?w=400&h=400&fit=crop",dominantColor:"#4338ca",explicit:!0,lyrics:[{time:0,text:"Desi je geet aa trapan di beat aa"},{time:18,text:"Sir kadd gajde brown munde"},{time:38,text:"Putt jattan de shonki caran de"},{time:58,text:"Brown Munde!"}]},{id:"t35",title:"Excuses",artist:"AP Dhillon & Intense",artistId:"ar6",album:"Brown Munde Chronicles",albumId:"al9",duration:218,audioUrl:"https://www.soundhelix.com/examples/mp3/SoundHelix-Song-3.mp3",coverUrl:"https://images.unsplash.com/photo-1492562080023-ab3db95bfbce?w=400&h=400&fit=crop",dominantColor:"#6366f1",explicit:!1,lyrics:[{time:0,text:"Kehndi hundi si chan tak raah bana de"},{time:16,text:"Taare ne pasand mainu hethaan saare laa de"},{time:36,text:"Ohna taareyan de vich jad mainu vekhegi"}]},{id:"t36",title:"Softly (Making Memories)",artist:"Karan Aujla & Ikky",artistId:"ar10",album:"Making Memories & Winning Speech",albumId:"al10",duration:220,audioUrl:"https://www.soundhelix.com/examples/mp3/SoundHelix-Song-4.mp3",coverUrl:"https://images.unsplash.com/photo-1519085360753-af0119f7cbe7?w=400&h=400&fit=crop",dominantColor:"#7c3aed",explicit:!0,lyrics:[{time:0,text:"Gaddi vich baith ke tu lagdi kamaal"},{time:16,text:"Aujla ni aujla kare jadon vaar"},{time:35,text:"Move your body softly to the beat!"}]}]},597);
